diff --git a/retry/retry.go b/retry/retry.go
index d49fd7e..3202b4c 100644
--- a/retry/retry.go
+++ b/retry/retry.go
@@ -2,7 +2,15 @@ package retry
 
 import "time"
 
-// Delay returns how long to wait before retry attempt n.
+// Delay returns how long to wait before retry attempt n (1-based): base for
+// the first retry, doubling each attempt, never more than max.
 func Delay(n int, base, max time.Duration) time.Duration {
-	return base
+	if n < 1 {
+		return 0
+	}
+	d := base << n
+	if d > max || d <= 0 {
+		return max
+	}
+	return d
 }
diff --git a/retry/retry_test.go b/retry/retry_test.go

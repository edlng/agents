{
  "name": "photon-lead",
  "description": "Main-thread lead for awslabs/photon. Plans, implements single-client changes, delegates ports, reviews and wide searches to subagents, runs a final cross-client alignment check, and reports gate results.",
  "prompt": "file://./kiro-prompt.md",
  "tools": [
    "read",
    "write",
    "shell",
    "subagent",
    "todo",
    "@pippin-mcp",
    "@creds-agent",
    "@codegraph"
  ],
  "allowedTools": [
    "read",
    "subagent",
    "todo",
    "@codegraph"
  ],
  "toolsSettings": {
    "subagent": {
      "trustedAgents": [
        "explore",
        "builder",
        "tester",
        "validator",
        "code-reviewer",
        "researcher",
        "research-validator"
      ]
    },
    "shell": {
      "timeout": 300000,
      "autoAllowReadonly": true
    }
  },
  "resources": [
    "skill://~/.kiro/skills/benchmark-checklist/SKILL.md",
    "skill://~/.kiro/skills/blast-radius/SKILL.md",
    "skill://~/.kiro/skills/how/SKILL.md",
    "skill://~/.kiro/skills/principle-boundary-discipline/SKILL.md",
    "skill://~/.kiro/skills/principle-fix-root-causes/SKILL.md",
    "skill://~/.kiro/skills/principle-make-operations-idempotent/SKILL.md",
    "skill://~/.kiro/skills/principle-prove-it-works/SKILL.md",
    "skill://~/.kiro/skills/principle-separate-before-serializing-shared-state/SKILL.md",
    "skill://~/.kiro/skills/principle-subtract-before-you-add/SKILL.md",
    "skill://~/.kiro/skills/principle-test-behavior-not-implementation/SKILL.md",
    "skill://~/.kiro/skills/review-pr/SKILL.md",
    "skill://~/.kiro/skills/tdd/SKILL.md",
    "skill://~/.kiro/skills/technical-writing/SKILL.md",
    "skill://~/.kiro/skills/unslop/SKILL.md",
    "skill://~/.kiro/skills/why/SKILL.md"
  ],
  "mcpServers": {
    "pippin-mcp": {
      "command": "pippin-mcp-server",
      "args": []
    },
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    }
  },
  "model": "claude-opus-4.8",
  "welcomeMessage": "Photon lead ready. What should we work on?"
}
